# Copy to .env for local development. Never commit .env.
# In production these are set in the Vercel project settings.

# development | production
APP_ENV=development

# Long random string used to sign session cookies (e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`)
SESSION_SECRET=

# Neon Postgres pooled connection string (use the dev branch locally)
DATABASE_URL=

# Google AI Studio key (use the dev project's key locally)
GEMINI_API_KEY=

# Groq console key (fallback provider)
GROQ_API_KEY=

# Ordered provider:model fallback chain
LLM_CHAIN=groq:openai/gpt-oss-120b,gemini:gemini-3.5-flash-lite,gemini:gemini-3.1-flash-lite

# AI rate limits
AI_RATE_LIMIT_PER_10MIN=20
AI_DAILY_SOFT_CAP=1500
